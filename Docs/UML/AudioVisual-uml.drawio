><mxCell id="c70" value="Eigendom: MainWindow maakt de VisualizerWidget met new aan en geeft zichzelf mee als parent. Qt ruimt het kind op in de destructor van de parent (raw pointer, bewust zo). VisualizerWidget gebruikt QOpenGLFunctions via protected overerving." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacing=6;fillColor=#fff9c4;strokeColor=#bfae3a;" vertex="1" parent="1"><mxGeometry x="1240" y="130" width="260" height="120" as="geometry"/></mxCell><mxCell id="c71" value="Nog niet gekoppeld (volgende stappen): AudioCapture en SpotifyClient worden nog niet gebruikt door MainWindow. Nog te bouwen: SpectrumAnalyzer (samples -&gt; bands), EffectDecorator en extra effecten. Dit diagram toont alleen wat nu in de code staat." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacing=6;fillColor=#fff9c4;strokeColor=#bfae3a;" vertex="1" parent="1"><mxGeometry x="420" y="692" width="360" height="110" as="geometry"/></mxCell><mxCell id="c72" value="" style="endArrow=block;endFill=0;endSize=12;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c73" value="" style="endArrow=block;endFill=0;endSize=12;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c23" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c74" value="" style="endArrow=block;endFill=0;endSize=12;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c13" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c75" value="" style="endArrow=block;endFill=0;endSize=12;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c47" target="c46"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c76" value="" style="endArr